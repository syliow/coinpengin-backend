# Environment Variables Configuration

# MongoDB Connection
MONGO_URL=mongodb://localhost:27017/coinpengin
# Or use MongoDB Atlas:
# MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/coinpengin?retryWrites=true&w=majority

# JWT Secret (use a strong random string in production)
JWT_SECRET=your_jwt_secret_key_here_change_this_in_production

# Server Port (optional, defaults to 5000)
PORT=5000

# Node Environment (development, production, or test)
NODE_ENV=development

# CoinGecko API Key (optional, but recommended for higher rate limits)
# Get your free API key from https://www.coingecko.com/en/api
COINGECKO_API_KEY=your_coingecko_api_key_here
